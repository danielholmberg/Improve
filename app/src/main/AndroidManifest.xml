<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phone calls (contacts feature) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Modern image access (Android 13+) — replaces READ_EXTERNAL_STORAGE for VIP images -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- WRITE_EXTERNAL_STORAGE and READ_EXTERNAL_STORAGE intentionally removed:
         Scoped storage (API 29+) + Photo Picker API replaces them -->

    <application
        android:name=".ImproveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_improve_launcher_square"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_improve_launcher_circle"
        android:supportsRtl="true"
        android:theme="@style/Theme.Improve"
        tools:ignore="GoogleAppIndexingWarning">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <meta-data
            android:name="firebase_crash_collection_enabled"
            android:value="${crashlyticsEnabled}" />

        <!-- Single activity — hosts the full Compose NavGraph -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging -->
        <service
            android:name=".services.ImproveMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
